#!/usr/bin/env python3
"""CLI wrapper: prefer Node.js implementation, fall back to Python.
Usage: python3 skills/topic-news-search/scripts/company-news "Query"
"""
import shutil
import subprocess
import sys
import os

def main(argv):
    if len(argv) == 0:
        print('{"query":"","results":[]}')
        return
    args = argv
    query = " ".join(args)

    repo_root = os.getcwd()
    js_path = os.path.join(repo_root, "skills", "topic-news-search", "scripts", "fetch_news.js")
    py_path = os.path.join(repo_root, "skills", "topic-news-search", "scripts", "fetch_news.py")

    if shutil.which("node") and os.path.isfile(js_path):
        cmd = ["node", js_path] + args
    elif os.path.isfile(py_path):
        cmd = ["python3", py_path] + args
    else:
        print('{"query":"","results":[]}')
        return

    out = subprocess.check_output(cmd, text=True)
    sys.stdout.write(out)

if __name__ == '__main__':
    main(sys.argv[1:])
