# OpenClaw + QMD Memory environment
# Copy this file to .env and run ./setup-ollama.sh
#
# Generate a gateway token:  openssl rand -hex 32

# ── Gateway auth (required) ──────────────────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token

# ── Gateway network ──────────────────────────────────────────────────────────
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
# Security: use 'loopback' to bind to 127.0.0.1 only (recommended).
# Use 'lan' only if you need LAN access and have Tailscale/TLS in front.
OPENCLAW_GATEWAY_BIND=loopback

# ── Data directories (host paths, created automatically) ─────────────────────
OPENCLAW_CONFIG_DIR=./data/config
OPENCLAW_WORKSPACE_DIR=./data/workspace

# ── Model provider API keys (set at least one) ──────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Channel tokens (optional — set the ones you use) ─────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
