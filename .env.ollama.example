# OpenClaw + Ollama (Phi) environment
# Copy this file to .env and run ./setup-ollama.sh
#
# Generate a gateway token:  openssl rand -hex 32

# ── Gateway auth (required) ──────────────────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token

# ── Gateway network ──────────────────────────────────────────────────────────
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_BIND=lan

# ── Data directories (host paths, created automatically) ─────────────────────
OPENCLAW_CONFIG_DIR=./data/config
OPENCLAW_WORKSPACE_DIR=./data/workspace

# ── Ollama settings ──────────────────────────────────────────────────────────
# Host port for Ollama API (container always listens on 11434 internally)
OLLAMA_HOST_PORT=11434
# Ollama API key (dummy value — Ollama doesn't require a real key, but
# OpenClaw needs a non-empty value to activate the Ollama provider)
OLLAMA_API_KEY=ollama-local
# Model to pull on first run (change to phi4-mini, phi4:14b, etc.)
OLLAMA_MODEL=phi4

# ── Channel tokens (optional — set the ones you use) ─────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
